
# Trivio — Local Development Environment
#
# Copy this file to .env before starting the application.
# Generate unique secret values for each installation.
# Never commit the .env file or use these placeholders as real credentials.

# Root password for newly initialized Docker MySQL databases
TRIVIO_MYSQL_ROOT_PASSWORD=replace_with_a_unique_secure_root_password

# Shared MySQL application-user password (local Docker databases)
TRIVIO_DB_PASSWORD=replace_with_a_secure_database_password

# Secret used for authenticated internal service communication
TRIVIO_INTERNAL_API_KEY=replace_with_a_long_random_api_key

# Base64-encoded JWT signing key (at least 32 random bytes)
TRIVIO_JWT_SECRET_BASE64=replace_with_a_secure_base64_encoded_jwt_key

# One-time owner setup authorization key
# Generate a unique random key for every Trivio installation.
TRIVIO_OWNER_SETUP_KEY=replace_with_a_secure_random_setup_key

# Local host networking
# Choose your own loopback binding and available host ports.
# These settings are local to each installation.
TRIVIO_BIND_ADDRESS=SET_LOCAL_LOOPBACK_ADDRESS
TRIVIO_GATEWAY_HOST_PORT=SET_AVAILABLE_HOST_PORT
TRIVIO_AUTH_HOST_PORT=SET_AVAILABLE_HOST_PORT
TRIVIO_VEHICLE_HOST_PORT=SET_AVAILABLE_HOST_PORT
TRIVIO_ORDER_HOST_PORT=SET_AVAILABLE_HOST_PORT
TRIVIO_PAYMENT_HOST_PORT=SET_AVAILABLE_HOST_PORT
TRIVIO_CONFIG_HOST_PORT=SET_AVAILABLE_HOST_PORT
TRIVIO_DISCOVERY_HOST_PORT=SET_AVAILABLE_HOST_PORT
TRIVIO_VEHICLE_REPLICATION_PORT=SET_AVAILABLE_HOST_PORT
TRIVIO_ORDER_REPLICATION_PORT=SET_AVAILABLE_HOST_PORT
TRIVIO_PAYMENT_REPLICATION_PORT=SET_AVAILABLE_HOST_PORT
TRIVIO_USERS_REPLICATION_PORT=SET_AVAILABLE_HOST_PORT
